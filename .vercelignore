# `vercel deploy` from a local checkout uploads this folder directly, and
# without this file it included the local .env — whose NEXTAUTH_URL
# (localhost) and dev keys then overrode the production settings.
.env*
!.env.example
# Leading "/" = only the top-level folders of locally saved files. A bare
# "uploads" also matched src/app/uploads (the route that serves files),
# so it was never deployed.
/uploads
/public/uploads
/.next
/node_modules
/.claude
