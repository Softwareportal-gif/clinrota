# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# user-uploaded files (compliance docs, MOU documents) — local disk storage
# (UPLOAD_DIR overrides this in production); never committed
/uploads
/public/uploads

# Serwist build output — regenerated by `npm run build`. A stale committed
# copy would get served by `next dev` on anyone's machine as a real static
# file (dev mode only skips *regenerating* it, it doesn't stop /public
# from being served as-is), registering a service worker with old cached
# pages that dev mode was never supposed to have at all.
/public/sw.js
