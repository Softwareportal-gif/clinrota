# Postgres connection string (see README for local dev vs. hosted options)
DATABASE_URL="postgresql://user:password@localhost:5432/clinrota?schema=public"

# NextAuth (Auth.js) — generate with `npx auth secret`
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Email provider (magic link sign-in + notification emails) — Resend
RESEND_API_KEY=""
EMAIL_FROM="ClinRota <onboarding@resend.dev>"

# Claude API (Beatrice, the site-wide assistant widget) — get a key at
# https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Where uploaded compliance/MOU files are stored. Defaults to ./uploads;
# on Render this points at the persistent disk (see render.yaml).
# UPLOAD_DIR="/var/data/uploads"

# "true" shows a site-wide "Demo environment" banner (sample data only).
# DEMO_ENVIRONMENT="true"
