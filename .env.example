# Postgres connection string (see README for local dev vs. hosted options)
DATABASE_URL="postgresql://user:password@localhost:5432/praxxt?schema=public"

# NextAuth (Auth.js) — generate with `npx auth secret`
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Email provider (magic link sign-in + notification emails) — Resend
RESEND_API_KEY=""
EMAIL_FROM="Praxxt <onboarding@resend.dev>"

# Claude API (Beatrice, the site-wide assistant widget) — get a key at
# https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Uploaded compliance/MOU files. With BLOB_READ_WRITE_TOKEN set (added
# automatically when a Vercel Blob store is connected) they go to a private
# Blob store; otherwise to UPLOAD_DIR, default ./uploads.
# BLOB_READ_WRITE_TOKEN=""
# UPLOAD_DIR="./uploads"

# "true" shows a site-wide "Demo environment" banner (sample data only).
# DEMO_ENVIRONMENT="true"

# Anatomy Body Explorer (unpublished preview). Only these signed-in emails
# (comma-separated) can open /anatomy while ANATOMY_PREVIEW is "true".
# ANATOMY_PREVIEW="false"
# ANATOMY_PREVIEW_EMAILS="tester@example.com"

# Cloudflare R2 bucket holding the 3D model files (private; served through
# short-lived signed links). Without these, local dev reads ANATOMY_BUILD_DIR.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="praxxt-anatomy"
# ANATOMY_BUILD_DIR="./anatomy-build"
